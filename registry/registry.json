    {
      "name": "cc-safety-net",
      "displayName": "命令安全守卫",
      "description": "执行前命令守卫：解析命令意图，拦截破坏性 Git/文件命令与敏感文件（SSH key / .env / ~/.aws）访问。移植自 kenryu42/cc-safety-net 的 checkCommand 库 API。",
      "type": "plugin",
      "version": "0.1.0",
      "author": "liuhualiang",
      "license": "MIT",
      "repo": "https://github.com/eppen/luban-plugins",
      "tags": [
        "safety",
        "git",
        "shell"
      ],
      "install": {
        "type": "git",
        "url": "git@github.com:eppen/luban-plugins.git",
        "subdir": "plugins/cc-safety-net",
        "target": "global"
      },
      "sourceSha256": "7fde042d9442b826d6b1d78ed1757dbb0be5ecb89867f7cd8ced9413c51c94c0",
      "ctxApi": ">=0.1 <1.0",
      "tools": [
        {
          "name": "check_command",
          "description": "检查一条 shell 命令是否危险（破坏性 Git 操作、rm -rf、curl|bash、敏感文件访问等）。返回 allow 或 deny（带原因与规则 ID）。在真正执行前调用它做一次前置判断。",
          "readOnly": true,
          "parameters": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "description": "要检查的完整 shell 命令"
              },
              "cwd": {
                "type": "string",
                "description": "执行命令的工作目录（绝对路径），缺省用当前工作区根"
              }
            },
            "required": [
              "command"
            ]
          }
        }
      ],
      "permissions": {
        "fsRead": false,
        "fsWrite": false,
        "shell": true,
        "net": false,
        "env": false
      },
      "review": {
        "status": "reviewed",
        "reviewedBy": "liuhualiang",
        "reviewedAt": "2026-11-13T00:59:49Z",
        "notes": "工具声明 readOnly，但 permissions.shell=true 已如实声明（实现通过 execFile 调用 git，只读检查不写盘/联网）。依赖外部 npm 包 cc-safety-net，安装时需 npm install cc-safety-net --prefix <插件目录>。"
      },
