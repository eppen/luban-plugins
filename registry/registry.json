      "ctxApi": ">=0.1 <1.0",
      "tools": [
        {
          "name": "now",
          "description": "返回本机当前时间（ISO 8601 与时区）",
          "readOnly": true,
          "parameters": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "disk_free",
          "description": "列出本机所有磁盘的剩余/已用空间（标注工作区所在盘）",
          "readOnly": true,
          "parameters": {
            "type": "object",
            "properties": {}
          }
        }
      ],
      "permissions": {
        "fsRead": false,
        "fsWrite": false,
        "shell": true,
        "net": false,
        "env": false
      },
      "review": {
        "status": "reviewed",
        "reviewedBy": "liuhualiang",
        "reviewedAt": "2026-11-12T14:30:00Z",
        "notes": "两个工具声明 readOnly，但 disk_free 通过 execFile 调用 df -k（只读取磁盘统计，未写盘/联网），与声明一致；shell=true 已如实声明。"
      },
