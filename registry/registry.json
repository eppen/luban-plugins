    {
      "name": "demo",
      "displayName": "Demo 小工具",
      "description": "Luban 本地插件示例：本机时间与工作区磁盘剩余空间",
      "type": "plugin",
      "version": "0.1.0",
      "author": "liuhualiang",
      "license": "MIT",
      "repo": "https://github.com/eppen/luban-plugins",
      "tags": [
        "demo",
        "system"
      ],
      "install": {
        "type": "git",
        "url": "git@github.com:eppen/luban-plugins.git",
        "subdir": "plugins/demo",
        "target": "global"
      },
      "sourceSha256": "f806fcc5d33aa49dda38b9dc19936d635adef498f0960987a08bd9b1d32c61cb",
      "ctxApi": ">=0.1 <1.0",
      "tools": [
        {
          "name": "now",
          "description": "返回本机当前时间（ISO 8601 与时区）",
          "readOnly": true,
          "parameters": {
            "type": "object",
            "properties": {}
          }
        },
        {
          "name": "disk_free",
          "description": "返回工作区所在磁盘的剩余空间",
          "readOnly": true,
          "parameters": {
            "type": "object",
            "properties": {}
          }
        }
      ],
      "permissions": {
        "fsRead": false,
        "fsWrite": false,
        "shell": true,
        "net": false,
        "env": false
      },
      "review": {
        "status": "reviewed",
        "reviewedBy": "liuhualiang",
        "reviewedAt": "2026-11-12T14:30:00Z",
        "notes": "两个工具声明 readOnly，但 disk_free 通过 execFile 调用 df -k（只读取磁盘统计，未写盘/联网），与声明一致；shell=true 已如实声明。"
      },
      "signature": {
        "algo": "ed25519",
        "keyId": "registry-ci",
        "sig": "rXVMOvPMaJVt5nLUHz+So/q3kYOMyKVNacH9AXUiyA69mwRzV3++kAO0Wvcw65EVBqfNuML/8f/xGlJtK2NfAg=="
      }
